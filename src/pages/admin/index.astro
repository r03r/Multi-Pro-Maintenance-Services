---
const pageTitle = 'Panel administrativo | MULTI-PRO';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex,nofollow" />
    <title>{pageTitle}</title>
    <link rel="stylesheet" href="/admin/admin.css" />
  </head>
  <body>
    <aside class="sidebar">
      <a class="brand" href="/" aria-label="MULTI-PRO inicio">
        <span class="brand-mark">MP</span>
        <span><strong>MULTI-PRO</strong><small>Administration</small></span>
      </a>
      <nav aria-label="Panel">
        <button class="nav-item active" data-view="dashboard">Resumen</button>
        <button class="nav-item" data-view="customers">Clientes</button>
        <button class="nav-item" data-view="estimates">Presupuestos</button>
        <button class="nav-item" data-view="invoices">Facturas</button>
      </nav>
      <p class="storage-note">Los datos se guardan en este dispositivo.</p>
    </aside>

    <main>
      <header class="topbar">
        <div><p class="eyebrow">MULTI-PRO</p><h1 id="view-title">Resumen</h1></div>
        <button class="primary" id="primary-action">+ Nuevo cliente</button>
      </header>

      <section class="view active" id="dashboard-view">
        <div class="stats">
          <article><span>Clientes</span><strong id="stat-customers">0</strong></article>
          <article><span>Presupuestos</span><strong id="stat-estimates">0</strong></article>
          <article><span>Facturado</span><strong id="stat-invoiced">$0.00</strong></article>
          <article><span>Pendiente</span><strong id="stat-pending">$0.00</strong></article>
        </div>
        <article class="panel">
          <div class="panel-heading"><div><h2>Actividad reciente</h2><p>Últimos documentos creados</p></div></div>
          <div id="recent-list" class="empty">Todavía no hay documentos.</div>
        </article>
      </section>

      <section class="view" id="customers-view">
        <article class="panel"><div class="panel-heading"><div><h2>Clientes</h2><p>Contactos y direcciones de servicio</p></div></div><div id="customers-list"></div></article>
      </section>

      <section class="view" id="estimates-view">
        <article class="panel"><div class="panel-heading"><div><h2>Presupuestos</h2><p>Crea, imprime y convierte presupuestos</p></div></div><div id="estimates-list"></div></article>
      </section>

      <section class="view" id="invoices-view">
        <article class="panel"><div class="panel-heading"><div><h2>Facturas</h2><p>Control de cobros y trabajos completados</p></div></div><div id="invoices-list"></div></article>
      </section>
    </main>

    <dialog id="record-dialog">
      <form id="record-form" method="dialog">
        <div class="dialog-heading"><div><p class="eyebrow">MULTI-PRO</p><h2 id="dialog-title">Nuevo cliente</h2></div><button class="icon-button" value="cancel" aria-label="Cerrar">×</button></div>
        <input type="hidden" id="record-type" />
        <div id="customer-fields" class="form-grid">
          <label>Nombre completo<input id="customer-name" autocomplete="name" /></label>
          <label>Empresa<input id="customer-company" autocomplete="organization" /></label>
          <label>Teléfono<input id="customer-phone" type="tel" autocomplete="tel" /></label>
          <label>Correo<input id="customer-email" type="email" autocomplete="email" /></label>
          <label class="wide">Dirección del servicio<input id="customer-address" autocomplete="street-address" /></label>
        </div>
        <div id="document-fields" class="form-grid hidden">
          <label class="wide">Cliente<select id="document-customer"></select></label>
          <label class="wide">Descripción del trabajo<textarea id="document-description" rows="4"></textarea></label>
          <label>Cantidad<input id="document-quantity" type="number" min="1" step="1" value="1" /></label>
          <label>Precio unitario<input id="document-price" type="number" min="0" step="0.01" value="0" /></label>
          <label>Impuesto (%)<input id="document-tax" type="number" min="0" step="0.01" value="0" /></label>
          <label>Estado<select id="document-status"><option value="draft">Borrador</option><option value="sent">Enviado</option><option value="accepted">Aceptado</option><option value="paid">Pagado</option></select></label>
          <label class="wide">Notas<textarea id="document-notes" rows="3"></textarea></label>
        </div>
        <div class="dialog-actions"><button class="secondary" value="cancel">Cancelar</button><button class="primary" id="save-record" value="default">Guardar</button></div>
      </form>
    </dialog>

    <script src="/admin/admin.js"></script>
  </body>
</html>
