---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import WhyUs from '../components/WhyUs.astro';
import Testimonials from '../components/Testimonials.astro';
import AreaContact from '../components/AreaContact.astro';
import Footer from '../components/Footer.astro';
import FloatingActions from '../components/FloatingActions.astro';
import Chatbot from '../components/Chatbot.astro';
---

<Layout>
  <Header />
  <main>
    <Hero />
    <Services />
    <WhyUs />
    <Testimonials />
    <AreaContact />
  </main>
  <Footer />
  <FloatingActions />
  <Chatbot />
</Layout>

<!-- Global i18n + interactions script -->
<script>
  // ---- Language system ----
  let currentLang = 'en';
  window.__currentLang = 'en';

  function applyLang(lang) {
    currentLang = lang;
    window.__currentLang = lang;

    // Update all [data-es] [data-en] elements
    document.querySelectorAll('[data-es][data-en]').forEach(el => {
      const txt = lang === 'en' ? el.dataset.en : el.dataset.es;
      if (txt !== undefined) {
        if (!el.classList.contains('chip-label')) {
          el.textContent = txt;
        }
      }
    });

    // Update placeholders
    document.querySelectorAll('input[data-ph-en][data-ph-es]').forEach(el => {
      el.placeholder = lang === 'en' ? el.dataset.phEn : el.dataset.phEs;
    });

    // Update lang buttons
    document.getElementById('lang-es')?.classList.toggle('active', lang === 'es');
    document.getElementById('lang-en')?.classList.toggle('active', lang === 'en');

    // Update html lang
    document.documentElement.lang = lang;

    // Update chat if exists
    if (window.__updateChatLang) window.__updateChatLang(lang);

    // Persist
    try { localStorage.setItem('mp_lang', lang); } catch { /* Storage may be disabled. */ }
  }

  // Lang button handlers
  document.getElementById('lang-es')?.addEventListener('click', () => applyLang('es'));
  document.getElementById('lang-en')?.addEventListener('click', () => applyLang('en'));

  // Restore lang from storage or default to EN
  let savedLang = null;
  try { savedLang = localStorage.getItem('mp_lang'); } catch { /* Use the default language. */ }
  if (savedLang === 'es' || savedLang === 'en') {
    applyLang(savedLang);
  } else {
    applyLang('en');
  }

  // ---- Header scroll effect ----
  const header = document.getElementById('header');
  let lastY = 0;
  window.addEventListener('scroll', () => {
    const y = window.scrollY;
    if (y > 100) {
      header?.classList.add('scrolled');
    } else {
      header?.classList.remove('scrolled');
    }
    lastY = y;
  }, { passive: true });

  // ---- Mobile hamburger ----
  const hamburger = document.getElementById('hamburger');
  const mobileMenu = document.getElementById('mobile-menu');
  function closeMobileMenu(restoreFocus = false) {
    hamburger?.classList.remove('open');
    hamburger?.setAttribute('aria-expanded', 'false');
    mobileMenu?.classList.remove('open');
    if (mobileMenu) mobileMenu.inert = true;
    document.body.style.overflow = '';
    if (restoreFocus) hamburger?.focus();
  }
  hamburger?.addEventListener('click', () => {
    if (mobileMenu?.classList.contains('open')) return closeMobileMenu(true);
    hamburger.classList.add('open');
    hamburger.setAttribute('aria-expanded', 'true');
    if (mobileMenu) { mobileMenu.inert = false; mobileMenu.classList.add('open'); }
    document.body.style.overflow = 'hidden';
    document.getElementById('mobile-close')?.focus();
  });
  document.getElementById('mobile-close')?.addEventListener('click', () => closeMobileMenu(true));
  document.querySelectorAll('.mobile-link').forEach(link => {
    link.addEventListener('click', () => closeMobileMenu());
  });
  document.addEventListener('keydown', (event) => {
    if (!mobileMenu?.classList.contains('open')) return;
    if (event.key === 'Escape') closeMobileMenu(true);
    if (event.key === 'Tab') {
      const items = [...mobileMenu.querySelectorAll('a, button')];
      const first = items[0], last = items[items.length - 1];
      if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last?.focus(); }
      else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first?.focus(); }
    }
  });
  window.matchMedia('(min-width: 901px)').addEventListener('change', (event) => {
    if (event.matches && mobileMenu?.classList.contains('open')) closeMobileMenu();
  });

  // ---- Intersection Observer for animations ----
  const observerOptions = {
    threshold: 0.1,
    rootMargin: '0px 0px -50px 0px'
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('active');
        // Optional: stop observing once revealed
        // observer.unobserve(entry.target);
      }
    });
  }, observerOptions);

  document.querySelectorAll('.reveal').forEach(el => {
    observer.observe(el);
  });
</script>

<style is:global>
  .header.scrolled {
    background: rgba(10,10,10,0.98) !important;
    border-bottom-color: var(--border2) !important;
  }
</style>
