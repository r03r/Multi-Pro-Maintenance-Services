---
import { SERVICES, t as TRANSLATIONS } from "../data/content.js";

const popular_cities = ["Los Angeles", "Pasadena", "Glendale", "Santa Monica", "Burbank", "Other / Otra"];

// Prepare arrays for budget and timeline from TRANSLATIONS
const budgetKeys = ["budget_1", "budget_2", "budget_3", "budget_4", "budget_5"];
const timeKeys = ["time_1", "time_2", "time_3", "time_4"];
---

<div class="chat-overlay" id="chat-overlay" onclick="chatOverlayClick(event)">
  <div class="chat-modal" id="chat-modal">
    <!-- Header -->
    <div class="chat-header">
      <div class="chat-header-left">
        <div class="chat-avatar">
          <img src="/email-signature/logo-main.jpg" alt="Multi-Pro" width="36" height="36" />
        </div>
        <div>
          <span class="chat-name">Multi-Pro Assistant</span>
          <span class="chat-status">● <span data-en="Online" data-es="En línea">En línea</span></span>
        </div>
      </div>
      <button class="chat-close" onclick="closeChat()" aria-label="Cerrar">✕</button>
    </div>

    <!-- Progress bar -->
    <div class="chat-progress">
      <div class="chat-progress-bar" id="chat-progress-bar"></div>
    </div>

    <!-- Messages -->
    <div class="chat-messages" id="chat-messages"></div>

    <!-- Input area -->
    <div class="chat-footer" id="chat-footer">
      <!-- Text input -->
      <div class="chat-input-row" id="chat-text-input" style="display:none">
        <input type="text" id="chat-text-field" class="chat-input" placeholder="" autocomplete="off" />
        <button class="chat-send-btn" id="chat-send-btn" onclick="chatSendText()">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
        </button>
      </div>

      <!-- Service chips -->
      <div class="chat-chips-wrap" id="chat-service-chips" style="display:none">
        {SERVICES.map((s) => (
          <button class="chat-chip" data-key={s.key} onclick={`chatPickService('${s.key}')`}>
            <span class="chip-icon">{s.icon}</span>
            <span class="chip-label" data-es={s.es} data-en={s.en}>{s.es}</span>
          </button>
        ))}
      </div>

      <!-- City chips -->
      <div class="chat-chips-wrap" id="chat-city-chips" style="display:none">
        {popular_cities.map((city) => (
          <button class="chat-chip" onclick={city === "Other / Otra" ? "switchToManualCity()" : `chatPickCity('${city}')`}>
            <span class="chip-label">{city}</span>
          </button>
        ))}
      </div>

      <!-- Budget chips -->
      <div class="chat-chips-wrap" id="chat-budget-chips" style="display:none">
        {budgetKeys.map((key) => (
          <button class="chat-chip" onclick={`chatPickBudget(this)`}>
            <span class="chip-label" data-es={TRANSLATIONS[key].es} data-en={TRANSLATIONS[key].en}>{TRANSLATIONS[key].es}</span>
          </button>
        ))}
      </div>

      <!-- Timeline chips -->
      <div class="chat-chips-wrap" id="chat-timeline-chips" style="display:none">
        {timeKeys.map((key) => (
          <button class="chat-chip" onclick={`chatPickTimeline(this)`}>
            <span class="chip-label" data-es={TRANSLATIONS[key].es} data-en={TRANSLATIONS[key].en}>{TRANSLATIONS[key].es}</span>
          </button>
        ))}
      </div>

      <!-- Done buttons -->
      <div class="chat-done-btns" id="chat-done-btns" style="display:none">
        <a href="#" id="chat-wa-btn" target="_blank" class="btn-primary chat-wa-btn">
          📱 <span data-es={TRANSLATIONS.chat_wa_btn.es} data-en={TRANSLATIONS.chat_wa_btn.en}>{TRANSLATIONS.chat_wa_btn.es}</span>
        </a>
        <button class="btn-ghost" onclick="chatRestart()" data-es={TRANSLATIONS.chat_restart.es} data-en={TRANSLATIONS.chat_restart.en}>{TRANSLATIONS.chat_restart.es}</button>
      </div>
    </div>
  </div>
</div>

<script is:inline define:vars={{ TRANSLATIONS }}>
  let chatLang = window.__currentLang || "en";
  let chatStep = "idle"; 
  let chatData = {};

  const PROGRESS = { service: 15, address: 30, budget: 45, timeline: 60, name: 75, phone: 90, done: 100 };

  function tt(key, vars = {}) {
    let entry = TRANSLATIONS[key] || TRANSLATIONS["chat_" + key];
    let str = entry?.[chatLang] || entry?.es || key;
    for (const [k, v] of Object.entries(vars)) str = str.replaceAll(`{${k}}`, v);
    return str;
  }

  const $msgs = () => document.getElementById("chat-messages");
  const $bar = () => document.getElementById("chat-progress-bar");

  function addBubble(text, type = "bot", step = "") {
    const msgs = $msgs();
    if (!msgs) return;

    if (type === "bot") {
      document.querySelectorAll(".bubble-bot.latest-prompt").forEach(el => el.classList.remove("latest-prompt"));
    }

    const bubble = document.createElement("div");
    bubble.className = `bubble bubble-${type} ${type === "bot" ? "latest-prompt" : ""} ${step ? 'step-' + step : ''}`;
    bubble.innerHTML = `<div class="bubble-inner">${text}</div>`;
    msgs.appendChild(bubble);
    msgs.scrollTo({ top: msgs.scrollHeight, behavior: 'smooth' });
  }

  function addTyping() {
    const msgs = $msgs();
    if (!msgs) return;
    const typing = document.createElement("div");
    typing.className = "bubble bubble-bot typing-indicator";
    typing.id = "typing-bubble";
    typing.innerHTML = '<div class="bubble-inner"><span></span><span></span><span></span></div>';
    msgs.appendChild(typing);
    msgs.scrollTop = msgs.scrollHeight;
  }

  function removeTyping() { document.getElementById("typing-bubble")?.remove(); }

  function setProgress(step) {
    const p = PROGRESS[step] || 0;
    const bar = $bar();
    if (bar) bar.style.width = `${p}%`;
  }

  function showInput(type) {
    ["chat-text-input", "chat-service-chips", "chat-city-chips", "chat-budget-chips", "chat-timeline-chips", "chat-done-btns"].forEach(id => {
      const el = document.getElementById(id);
      if (el) el.style.display = "none";
    });
    const map = { text: "chat-text-input", service: "chat-service-chips", city: "chat-city-chips", budget: "chat-budget-chips", timeline: "chat-timeline-chips", done: "chat-done-btns" };
    if (map[type]) {
        const el = document.getElementById(map[type]);
        if (el) el.style.display = "flex";
        if (type === "text") {
          const field = document.getElementById("chat-text-field");
          if (field) field.focus();
        }
    }
  }

  function botSay(text, step = "", delay = 600) {
    addTyping();
    setTimeout(() => { removeTyping(); addBubble(text, "bot", step); }, delay);
  }

  window.startChat = function() {
    chatData = {};
    const msgs = $msgs();
    if (msgs) msgs.innerHTML = "";
    chatLang = window.__currentLang || "en";
    setProgress("service");
    addBubble(tt("chat_greeting"), "bot");
    setTimeout(() => { botSay(tt("chat_q_service"), "service"); showInput("service"); chatStep = "service"; }, 800);
  }

  window.chatPickService = function(key) {
    const btn = document.querySelector(`[data-key="${key}"]`);
    const label = btn?.querySelector(".chip-label");
    const display = label ? (chatLang === "en" ? label.dataset.en : label.dataset.es) : key;
    chatData.service = display;
    addBubble(display, "user");
    setProgress("address");
    botSay(tt("chat_q_address", { service: display }), "address");
    setTimeout(() => showInput("city"), 800);
    chatStep = "address";
  }

  window.chatPickCity = function(city) {
    addBubble(city, "user");
    chatData.address = city;
    toBudget();
  }

  window.switchToManualCity = function() {
    const field = document.getElementById("chat-text-field");
    if (field) field.placeholder = tt("ph_address");
    showInput("text");
  }

  function toBudget() {
    setProgress("budget");
    botSay(tt("chat_q_budget"), "budget");
    setTimeout(() => showInput("budget"), 800);
    chatStep = "budget";
  }

  window.chatPickBudget = function(btn) {
    const label = btn.querySelector(".chip-label");
    const display = chatLang === "en" ? label.dataset.en : label.dataset.es;
    chatData.budget = display;
    addBubble(display, "user");
    setProgress("timeline");
    botSay(tt("chat_q_timeline"), "timeline");
    setTimeout(() => showInput("timeline"), 800);
    chatStep = "timeline";
  }

  window.chatPickTimeline = function(btn) {
    const label = btn.querySelector(".chip-label");
    const display = chatLang === "en" ? label.dataset.en : label.dataset.es;
    chatData.timeline = display;
    addBubble(display, "user");
    setProgress("name");
    botSay(tt("chat_q_name"), "name");
    const field = document.getElementById("chat-text-field");
    if (field) field.placeholder = tt("ph_name");
    setTimeout(() => showInput("text"), 800);
    chatStep = "name";
  }

  window.chatSendText = function() {
    const field = document.getElementById("chat-text-field");
    const val = field?.value.trim();
    if (!val) return;
    field.value = "";
    addBubble(val, "user");

    if (chatStep === "address") {
      chatData.address = val;
      toBudget();
    } else if (chatStep === "name") {
      chatData.name = val;
      setProgress("phone");
      botSay(tt("chat_q_phone", { name: val }), "phone");
      if (field) field.placeholder = tt("ph_phone");
      chatStep = "phone";
    } else if (chatStep === "phone") {
      chatData.phone = val;
      finishChat();
    }
  }

  function finishChat() {
    setProgress("done");
    chatStep = "done";
    botSay(tt("chat_done"), "done");
    const waText = buildWAText();
    const waBtn = document.getElementById("chat-wa-btn");
    if (waBtn) waBtn.href = `https://wa.me/13239707517?text=${encodeURIComponent(waText)}`;
    setTimeout(() => showInput("done"), 1000);
  }

  function buildWAText() {
    const header = chatLang === "en" ? "🏠 *NEW PROJECT INQUIRY*" : "🏠 *NUEVA CONSULTA DE PROYECTO*";
    const labels = chatLang === "en" 
      ? { n: "Client", p: "Phone", s: "Service", a: "Location", b: "Budget", t: "Timeline" }
      : { n: "Cliente", p: "Teléfono", s: "Servicio", a: "Ubicación", b: "Presupuesto", t: "Tiempo" };
    return [
      header, "--------------------------",
      `*${labels.s}:* ${chatData.service}`,
      `*${labels.a}:* ${chatData.address}`,
      `*${labels.b}:* ${chatData.budget}`,
      `*${labels.t}:* ${chatData.timeline}`,
      "--------------------------",
      `*${labels.n}:* ${chatData.name}`,
      `*${labels.p}:* ${chatData.phone}`,
    ].join("\n");
  }

  window.chatRestart = () => startChat();
  window.openChat = function() {
    const overlay = document.getElementById("chat-overlay");
    if (overlay) {
      overlay.classList.add("open");
      document.body.style.overflow = "hidden";
      if (chatStep === "idle") startChat();
    }
  };
  window.closeChat = function() {
    const overlay = document.getElementById("chat-overlay");
    if (overlay) {
      overlay.classList.remove("open");
      document.body.style.overflow = "";
    }
  };
  window.chatOverlayClick = (e) => { if (e.target.id === "chat-overlay") window.closeChat(); };

  window.__updateChatLang = (lang) => {
    chatLang = lang;
    document.querySelectorAll(".chip-label[data-es][data-en]").forEach((el) => {
      el.textContent = lang === "en" ? el.dataset.en : el.dataset.es;
    });
    document.querySelectorAll(".chat-done-btns [data-es][data-en]").forEach((el) => {
      el.textContent = lang === "en" ? el.dataset.en : el.dataset.es;
    });
    const field = document.getElementById("chat-text-field");
    if (field) {
      if (chatStep === "name") field.placeholder = tt("ph_name");
      else if (chatStep === "phone") field.placeholder = tt("ph_phone");
      else if (chatStep === "address") field.placeholder = tt("ph_address");
    }
  };

  document.addEventListener("DOMContentLoaded", () => {
    document.getElementById("chat-text-field")?.addEventListener("keydown", (e) => { if (e.key === "Enter") chatSendText(); });
  });
</script>

<style>
  .chat-overlay { position: fixed; inset: 0; z-index: 1000; background: rgba(0, 0, 0, 0.7); display: flex; align-items: flex-end; justify-content: flex-end; padding: 24px; opacity: 0; pointer-events: none; transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); }
  .chat-overlay.open { opacity: 1; pointer-events: all; }
  .chat-modal { width: 100%; max-width: 420px; height: 650px; background: #0F0F10; border: 1px solid rgba(255,255,255,0.1); border-radius: 24px; display: flex; flex-direction: column; overflow: hidden; box-shadow: 0 40px 80px rgba(0,0,0,0.6); transform: translateY(40px) scale(0.95); transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1); }
  .chat-overlay.open .chat-modal { transform: translateY(0) scale(1); }
  .chat-header { display: flex; align-items: center; justify-content: space-between; padding: 20px 24px; background: rgba(20,20,22,0.8); border-bottom: 1px solid rgba(255,255,255,0.05); backdrop-filter: blur(10px); }
  .chat-header-left { display: flex; align-items: center; gap: 14px; }
  .chat-avatar { width: 44px; height: 44px; border-radius: 14px; overflow: hidden; border: 1px solid rgba(255,255,255,0.1); background: #1C1C1E; }
  .chat-avatar img { width: 100%; height: 100%; object-fit: contain; }
  .chat-name { display: block; font-weight: 700; font-size: 16px; color: #FFF; letter-spacing: -0.01em; }
  .chat-status { display: flex; align-items: center; gap: 5px; font-size: 12px; color: #34C759; font-weight: 600; }
  .chat-close { width: 32px; height: 32px; border-radius: 10px; background: rgba(255,255,255,0.05); color: #8E8E93; display: flex; align-items: center; justify-content: center; transition: all 0.2s; }
  .chat-close:hover { background: rgba(255,255,255,0.1); color: #FFF; }
  .chat-progress { height: 4px; background: rgba(255,255,255,0.03); }
  .chat-progress-bar { height: 100%; background: linear-gradient(90deg, var(--orange), #FF8A00); width: 0%; transition: width 0.6s cubic-bezier(0.16, 1, 0.3, 1); }
  .chat-messages { flex: 1; overflow-y: auto; padding: 24px; display: flex; flex-direction: column; gap: 16px; scroll-behavior: smooth; }
  .chat-messages::-webkit-scrollbar { width: 4px; }
  .chat-messages::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.1); border-radius: 10px; }
  .bubble { display: flex; max-width: 88%; animation: slideInUp 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
  .bubble-bot { align-self: flex-start; }
  .bubble-user { align-self: flex-end; }
  .bubble-inner { padding: 14px 18px; border-radius: 20px; font-size: 15px; line-height: 1.5; font-weight: 400; transition: all 0.3s ease; }
  .bubble-bot .bubble-inner { background: #1C1C1E; color: #E5E5E7; border-bottom-left-radius: 4px; border: 1px solid rgba(255,255,255,0.05); }
  .bubble-user .bubble-inner { background: var(--orange); color: white; border-bottom-right-radius: 4px; box-shadow: 0 4px 12px rgba(255,90,0,0.2); }
  .bubble-bot.latest-prompt .bubble-inner { background: rgba(52, 199, 89, 0.1); border-color: rgba(52, 199, 89, 0.5); box-shadow: 0 0 25px rgba(52, 199, 89, 0.2); color: #FFF; font-weight: 600; transform: scale(1.02); }
  .bubble-bot.step-budget.latest-prompt .bubble-inner { background: rgba(52, 199, 89, 0.15); border-color: rgba(52, 199, 89, 0.8); box-shadow: 0 0 35px rgba(52, 199, 89, 0.3); border-width: 2px; }
  @keyframes slideInUp { from { opacity: 0; transform: translateY(12px) scale(0.98); } to { opacity: 1; transform: translateY(0) scale(1); } }
  .typing-indicator .bubble-inner { display: flex; gap: 4px; padding: 16px 20px; background: #1C1C1E; }
  .typing-indicator span { width: 6px; height: 6px; background: #8E8E93; border-radius: 50%; animation: typing 1.4s infinite; }
  .typing-indicator span:nth-child(2) { animation-delay: 0.2s; }
  .typing-indicator span:nth-child(3) { animation-delay: 0.4s; }
  @keyframes typing { 0%, 60%, 100% { transform: translateY(0); opacity: 0.4; } 30% { transform: translateY(-4px); opacity: 1; } }
  .chat-footer { padding: 24px; background: #0F0F10; border-top: 1px solid rgba(255,255,255,0.05); }
  .chat-input-row { display: flex; gap: 12px; }
  .chat-input { flex: 1; background: #1C1C1E; border: 1px solid rgba(255,255,255,0.1); border-radius: 16px; padding: 14px 18px; color: #FFF; font-size: 15px; outline: none; transition: all 0.2s; }
  .chat-input:focus { border-color: var(--orange); background: #242426; }
  .chat-send-btn { width: 50px; height: 50px; background: var(--orange); color: #FFF; border-radius: 16px; display: flex; align-items: center; justify-content: center; transition: all 0.2s; }
  .chat-send-btn:hover { transform: scale(1.05); filter: brightness(1.1); }
  .chat-chips-wrap { display: flex; flex-wrap: wrap; gap: 10px; justify-content: flex-end; }
  .chat-chip { background: #1C1C1E; border: 1px solid rgba(255,255,255,0.1); border-radius: 100px; padding: 12px 20px; color: #FFF; font-size: 15px; font-weight: 500; transition: all 0.2s; animation: slideInUp 0.4s ease forwards; }
  .chat-chip:hover { border-color: var(--orange); transform: translateY(-2px); box-shadow: 0 4px 12px rgba(255,90,0,0.15); }
  .chat-done-btns { flex-direction: column; gap: 12px; width: 100%; }
  .chat-wa-btn { background: #25D366; width: 100%; justify-content: center; padding: 18px; font-size: 16px; font-weight: 700; border-radius: 18px; color: #FFF; transition: all 0.2s; }
  .chat-wa-btn:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(37, 211, 102, 0.3); }
  .btn-ghost { padding: 12px; font-size: 14px; color: #8E8E93; transition: color 0.2s; }
  .btn-ghost:hover { color: #FFF; }
  @media (max-width: 480px) { .chat-overlay { padding: 0; } .chat-modal { max-width: 100%; height: 90vh; border-radius: 32px 32px 0 0; } }
</style>
