---
---
<section class="hero-new">
  <!-- Intense Orange Glow Background -->
  <div class="hero-glow"></div>
  <div class="hero-glow-secondary"></div>

  <div class="container">
    <div class="hero-content">
      <!-- Medium Logo Display -->
      <div class="hero-main-logo reveal">
        <div class="hero-logo-wrapper">
          <img src="/brand/logo.png" alt="Multi-Pro Logo" class="hero-logo-img" width="612" height="408" fetchpriority="high" />
        </div>
      </div>

      <div class="hero-badge reveal">
        <span class="badge-dot"></span>
        <span data-es="Remodelación profesional en Los Ángeles" data-en="Professional Remodeling in Los Angeles">Professional Remodeling in Los Angeles</span>
      </div>

      <h1 class="hero-title reveal">
        <span data-es="Transformamos tu" data-en="We Transform Your">We Transform Your</span><br/>
        <span class="gradient-text-orange" data-es="hogar en el espacio" data-en="Home Into the Space">Home Into the Space</span><br/>
        <span data-es="que mereces" data-en="You Deserve">You Deserve</span>
      </h1>

      <p class="hero-sub reveal" data-es="Más de 12 años de experiencia transformando hogares en el área de Los Ángeles. Trabajo garantizado, presupuesto honesto." data-en="Over 12 years of experience transforming homes in the Los Angeles area. Guaranteed work, honest pricing.">
        Más de 15 años de experiencia transformando hogares en el área de Los Ángeles. Trabajo garantizado, presupuesto honesto.
      </p>

      <div class="hero-actions reveal">
        <button class="btn-orange-main" onclick="openChat()">
          <span data-es="Cotizar Ahora" data-en="Get a Quote">Cotizar Ahora</span>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14m-7-7 7 7-7 7"/></svg>
        </button>
        <a href="#services" class="btn-apple-secondary" data-es="Ver Servicios" data-en="View Services">Ver Servicios</a>
      </div>

      <div class="hero-stats reveal">
        <div class="stat-item">
          <span class="stat-num">12+</span>
          <span class="stat-label" data-es="Años" data-en="Years">Años</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
          <span class="stat-num">500+</span>
          <span class="stat-label" data-es="Proyectos" data-en="Projects">Proyectos</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
          <span class="stat-num">4.9★</span>
          <span class="stat-label">Rating</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-new {
    min-height: 100vh;
    display: flex;
    align-items: center;
    position: relative;
    padding-top: 120px; /* Espacio para el header fijo */
    padding-bottom: 80px;
    overflow: hidden;
    background: #000;
  }

  @media (max-width: 768px) {
    .hero-new {
      padding-top: 100px;
      padding-bottom: 40px;
      min-height: auto; /* Evita que el contenido se estire raro en móvil */
    }
  }

  .hero-glow {
    position: absolute;
    top: -20%;
    left: 20%;
    width: 60%;
    height: 80%;
    background: radial-gradient(circle at center, rgba(255, 90, 0, 0.15) 0%, transparent 70%);
    pointer-events: none;
    z-index: 0;
    filter: blur(80px);
  }

  .hero-glow-secondary {
    position: absolute;
    bottom: -10%;
    right: 10%;
    width: 40%;
    height: 60%;
    background: radial-gradient(circle at center, rgba(255, 90, 0, 0.08) 0%, transparent 70%);
    pointer-events: none;
    z-index: 0;
    filter: blur(60px);
  }

  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 1000px;
    margin: 0 auto;
    text-align: center;
  }

  /* Hero Logo Styling */
  .hero-main-logo {
    margin-bottom: 24px;
    display: flex;
    justify-content: center;
  }

  .hero-logo-wrapper {
    width: clamp(220px, 25vw, 280px);
    aspect-ratio: 3 / 2;
    border-radius: 28px;
    overflow: hidden;
    background: transparent;
    border: 0;
    transition: var(--transition-premium);
  }

  .hero-logo-wrapper:hover {
    transform: scale(1.05) translateY(-5px);
    border-color: var(--orange);
    box-shadow: 0 15px 50px rgba(255, 90, 0, 0.25);
  }

  .hero-logo-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transform: scale(1.5);
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: rgba(255, 90, 0, 0.04);
    border: 1px solid rgba(255, 90, 0, 0.15);
    padding: 10px 20px;
    border-radius: 100px;
    font-size: 14px;
    font-weight: 600;
    margin-bottom: 40px;
    color: var(--orange);
    letter-spacing: 0.02em;
    backdrop-filter: blur(12px) saturate(160%);
    -webkit-backdrop-filter: blur(12px) saturate(160%);
    transition: var(--transition-premium);
  }

  .hero-badge:hover {
    background: rgba(255, 90, 0, 0.08);
    border-color: var(--orange);
  }

  .badge-dot {
    width: 8px;
    height: 8px;
    background: var(--orange);
    border-radius: 50%;
    box-shadow: 0 0 12px var(--orange);
    animation: pulse 2s infinite;
  }

  .hero-title {
    font-size: clamp(3rem, 8vw, 6.5rem);
    line-height: 1.05;
    font-weight: 800;
    letter-spacing: -0.04em;
    margin-bottom: 32px;
    color: #FFF;
  }

  .gradient-text-orange {
    background: linear-gradient(135deg, #FF9500 0%, #FF5A00 50%, #FF3B00 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    display: inline-block;
  }

  .hero-sub {
    font-size: clamp(1.1rem, 2vw, 1.25rem);
    color: var(--text-dim);
    max-width: 650px;
    margin: 0 auto 56px;
    line-height: 1.6;
    font-weight: 400;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    margin-bottom: 48px;
  }

  .btn-orange-main {
    background: var(--orange);
    color: #FFFFFF;
    padding: 18px 36px;
    border-radius: 100px;
    font-weight: 700;
    font-size: 17px;
    display: flex;
    align-items: center;
    gap: 12px;
    transition: var(--transition-premium);
    box-shadow: 0 10px 30px rgba(255, 90, 0, 0.25);
    border: 1px solid rgba(255,255,255,0.1);
  }

  .btn-orange-main:hover {
    transform: scale(1.05) translateY(-4px);
    background: var(--orange-light);
    box-shadow: 0 20px 50px rgba(255, 90, 0, 0.4);
    border-color: rgba(255,255,255,0.2);
  }

  .btn-apple-secondary {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: #FFFFFF;
    padding: 18px 36px;
    border-radius: 100px;
    font-weight: 600;
    font-size: 17px;
    transition: var(--transition-premium);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .btn-apple-secondary:hover {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.2);
    transform: translateY(-2px);
  }

  .hero-stats {
    display: inline-flex;
    align-items: center;
    gap: 50px;
    padding: 28px 56px;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 32px;
    backdrop-filter: blur(25px) saturate(160%);
    -webkit-backdrop-filter: blur(25px) saturate(160%);
    transition: var(--transition-premium);
  }

  .hero-stats:hover {
    background: rgba(255, 255, 255, 0.04);
    border-color: rgba(255, 255, 255, 0.12);
    transform: translateY(-5px);
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .stat-num {
    font-size: 28px;
    font-weight: 800;
    color: #FFFFFF;
  }

  .stat-label {
    font-size: 13px;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-weight: 600;
  }

  .stat-divider {
    width: 1px;
    height: 40px;
    background: rgba(255, 255, 255, 0.1);
  }

  @media (max-width: 768px) {
    .hero-title { font-size: clamp(2rem, 8.8vw, 3.6rem); margin: 16px 0 24px; }
    .hero-badge { margin-bottom: 16px; font-size: 12px; }
    .hero-sub { margin-bottom: 28px; }
    .hero-actions {
      flex-direction: column;
      width: 100%;
    }
    .btn-orange-main, .btn-apple-secondary {
      width: 100%;
      justify-content: center;
    }
    .hero-stats {
      width: 100%;
      gap: 20px;
      padding: 20px;
      flex-wrap: wrap;
      justify-content: center;
    }
  }
</style>
