---
---
<div class="fab-stack" id="fab-stack">
  <!-- Chat (orange, opens chatbot) -->
  <div class="fab-wrapper">
    <div class="fab-pulse-ring"></div>
    <button class="fab fab-chat" id="fab-chat" onclick="openChat()" aria-label="Cotizar">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
      </svg>
    </button>
  </div>

  <!-- WhatsApp -->
  <a href="https://wa.me/13239707517?text=Hola%2C%20me%20gustar%C3%ADa%20una%20cotizaci%C3%B3n%20gratuita" 
     target="_blank" 
     class="fab fab-wa" 
     id="fab-whatsapp"
     aria-label="WhatsApp">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
    </svg>
  </a>

  <!-- SMS / iMessage -->
  <a href="sms:+13239707517" class="fab fab-sms" id="fab-sms" aria-label="SMS">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
      <polyline points="22,6 12,13 2,6"/>
    </svg>
  </a>

  <!-- Call -->
  <a href="tel:+13239707517" class="fab fab-call" id="fab-call" aria-label="Llamar">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.41 2 2 0 0 1 3.6 1.22h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.91 9a16 16 0 0 0 6 6l1.12-.91a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
    </svg>
  </a>
</div>

<style>
  .fab-stack {
    position: fixed;
    bottom: 28px;
    right: 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    z-index: 800;
  }

  .fab-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .fab-pulse-ring {
    position: absolute;
    inset: -6px;
    border-radius: 50%;
    border: 2px solid var(--orange);
    opacity: 0;
    animation: fab-pulse 2.5s ease-in-out infinite;
  }

  @keyframes fab-pulse {
    0% { transform: scale(0.95); opacity: 0.8; }
    100% { transform: scale(1.4); opacity: 0; }
  }

  .fab {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    border: none;
    cursor: pointer;
    transition: all 0.2s ease;
    position: relative;
    box-shadow: 0 4px 16px rgba(0,0,0,0.4);
  }

  .fab:hover {
    transform: scale(1.1);
  }

  .fab-chat {
    background: var(--orange);
    color: white;
    width: 58px;
    height: 58px;
  }

  .fab-chat:hover {
    background: var(--orange-light);
    box-shadow: 0 8px 24px rgba(255,90,0,0.45);
  }

  .fab-wa {
    background: var(--whatsapp);
    color: white;
  }

  .fab-wa:hover {
    box-shadow: 0 8px 24px rgba(37,211,102,0.45);
  }

  .fab-sms {
    background: var(--sms);
    color: white;
  }

  .fab-sms:hover {
    box-shadow: 0 8px 24px rgba(52,199,89,0.45);
  }

  .fab-call {
    background: var(--blue);
    color: white;
  }

  .fab-call:hover {
    box-shadow: 0 8px 24px rgba(0,85,255,0.45);
  }

  /* Tooltips */
  .fab::before {
    content: attr(aria-label);
    position: absolute;
    right: calc(100% + 12px);
    background: rgba(20,20,20,0.95);
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 11px;
    padding: 6px 10px;
    border-radius: 6px;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    border: 1px solid var(--border);
    transition: opacity 0.2s;
    letter-spacing: 0.03em;
  }

  .fab:hover::before {
    opacity: 1;
  }

  @media (max-width: 480px) {
    .fab-stack {
      bottom: 20px;
      right: 16px;
      gap: 8px;
    }
    .fab {
      width: 46px;
      height: 46px;
    }
    .fab-chat {
      width: 52px;
      height: 52px;
    }
    .fab::before {
      display: none;
    }
  }
</style>
